{
  "manifest_version": 3,
  "name": "SubCentral Job Filter",
  "version": "0.7.0",
  "description": "Search, filters, sorting, bike/transit commute times and a \"search finished\" notification for the SubCentral Available Jobs list.",
  "permissions": [
    "storage",
    "notifications",
    "declarativeNetRequestWithHostAccess"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "transitous_user_agent",
        "enabled": true,
        "path": "transitous_rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://photon.komoot.io/*",
    "https://api.transitous.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://subcentral.sfe.powerschool.com/substituteAvailableJob*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
